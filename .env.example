# Origin only, for example https://www.your-domain.com
PUBLIC_SITE_URL=
# / for a custom domain or user site; /repository-name/ for a project site
ASTRO_BASE=/
# Public HTTPS endpoint only; leave blank to disable live submission.
PUBLIC_BOOKING_API_URL=
# Development-only simulated failure; never enables a production mock.
PUBLIC_BOOKING_MOCK_FAIL=false
# Public HTTPS backend base URL for Places, Routes and quotes; never a Google key.
PUBLIC_ROUTE_API_URL=
# Explicit prototype-only simulated route preview; not real Google Maps data.
PUBLIC_ROUTE_DEMO=false
# Optional public search-engine verification tokens; leave blank until issued.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=