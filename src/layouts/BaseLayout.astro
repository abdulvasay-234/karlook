---
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import { seoFor } from '../lib/seo';
import { pathFor } from '../lib/paths';
import { websiteSchema } from '../lib/seo/structured';
import StructuredData from '../components/common/StructuredData.astro';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  robots?: string;
  image?: string;
  imageAlt?: string;
}
const {
  title,
  description,
  robots: requestedRobots = 'index, follow',
  image = '/images/chauffeur-hero.jpg',
  imageAlt = 'Illustrative luxury sedan',
} = Astro.props;
const robots = Astro.site ? requestedRobots : 'noindex, nofollow';
const seo = seoFor(title, description, Astro.url.pathname, Astro.site);
const socialImage = Astro.site
  ? new URL(pathFor(image), Astro.site).href
  : undefined;
const googleVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim() || '';
const bingVerification =
  import.meta.env.PUBLIC_BING_SITE_VERIFICATION?.trim() || '';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={robots} />
    {/^[A-Za-z0-9_-]{1,200}$/.test(googleVerification) && (
      <meta name="google-site-verification" content={googleVerification} />
    )}
    {/^[A-Za-z0-9_-]{1,200}$/.test(bingVerification) && (
      <meta name="msvalidate.01" content={bingVerification} />
    )}
    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="karLook" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    {seo.canonical && <meta property="og:url" content={seo.canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && <meta name="twitter:image:alt" content={imageAlt} />}
    <link rel="icon" type="image/svg+xml" href={pathFor('/favicon.svg')} />
  </head>
  <body>
    <StructuredData data={websiteSchema(Astro.site)} />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
