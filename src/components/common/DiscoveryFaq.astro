---
import type { Faq } from '../../data/service-faqs';
interface Props {
  faqs: readonly Faq[];
}
const { faqs } = Astro.props;
---

<div class="faq-list">
  {faqs.map((faq) => (
    <details data-reveal="up" data-reveal-stagger>
      <summary>
        {faq.question}
        <span aria-hidden="true">+</span>
      </summary>
      <p>{faq.answer}</p>
    </details>
  ))}
</div>
